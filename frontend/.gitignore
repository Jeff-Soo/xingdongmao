# ============================================================
# Pattern 前端（uni-app 小程序 + H5）— .gitignore
# ⚠️ 本文件不支持"行尾注释"：# 后面的内容会被当成规则的一部分，注释单独一行。
# ============================================================

# ---------- HBuilderX 构建产物 / 缓存 ----------
unpackage/
.hbuilderx/

# ---------- 依赖 ----------
node_modules/

# ---------- 打包 / 备份 / 临时 ----------
*.tar.gz
*.zip
*.bak
*.bak-*
*.orig
*.rej
*.log

# ---------- 环境 / 密钥（前端目前没有，留规则防以后误提交）----------
.env
.env.*

# ---------- 编辑器 / 系统 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
